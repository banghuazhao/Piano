<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac Catalyst build links no ad SDK, so it carries no AdMob identifiers,
	     SKAdNetwork list, or tracking usage description. Everything else in the
	     bundle is generated from the target's build settings. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect a Bluetooth MIDI keyboard to play PianoFlow.</string>
</dict>
</plist>
